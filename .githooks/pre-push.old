#!/usr/bin/env bash
# Chains every hook system this repo uses (ADR 0012).
#
# beads sets core.hooksPath to .beads/hooks, which silently overrides the
# .git/hooks that lefthook installs. That is why the Build gate never ran once
# in this project's life: lefthook.yml looked correct, lefthook was never
# installed, and even installed it would have lost to beads.
#
# So neither tool owns the path — this directory does, and it calls both.
set -euo pipefail
hook=pre-push

run_beads() {
  b="$(git rev-parse --show-toplevel)/.beads/hooks/$hook"
  [ -x "$b" ] || return 0
  "$b" "$@"
}

run_lefthook() {
  command -v lefthook >/dev/null || {
    # Loud, not silent. A missing gate that says nothing is how this repo
    # shipped a decorative one for months.
    echo "warning: lefthook not installed — the $hook gate is NOT running." >&2
    echo "         install it: go install github.com/evilmartians/lefthook@latest" >&2
    return 0
  }
  lefthook run "$hook" "$@"
}

run_beads "$@"
run_lefthook "$@"
