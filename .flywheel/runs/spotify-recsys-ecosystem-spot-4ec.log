85),\n    \"ndcg_100\":    (0.1889, 0.149, -0.00579, 0.0222),\n    \"clicks\":      (8.90,   14.0,  +0.31000, 2.40),\n}\nA, B = MetricAccumulator(), MetricAccumulator()\nfor name, (m, sd, d, dsd) in specs.items():\n    a = pin(rng.normal(size=400), m, sd)\n    b = a + pin(rng.normal(size=400), d, dsd)\n    for x, y in zip(a, b):\n        A.add(name, float(x)); B.add(name, float(y))\n\nmeta = {\"k\": 0, \"n\": 400, \"depth\": 500, \"reranker\": False,\n        \"arm_a\": {\"label\": label({})}, \"arm_b\": {\"label\": label({\"rrf_k\": 30.0})}}\nprint(_format(compare(A, B), meta))\nPY","description":"Smoke-render the report table"}},{"tool_name":"Bash","tool_use_id":"toolu_01LbwKQ41HGbGgXma5LLPxg2","tool_input":{"command":"cadence/.venv/bin/python -m pytest cadence/tests/test_eval_ab.py -q --no-header -p no:cacheprovider 2>&1 | tail -25","timeout":300000,"description":"Run eval_ab tests"}},{"tool_name":"Bash","tool_use_id":"toolu_01Jnkq8YrvovLP6aXPQB6ZNj","tool_input":{"command":"cadence/.venv/bin/python -m pytest cadence/tests/test_eval_ab.py -q --no-header -k format -s","timeout":300000,"description":"Run format tests"}},{"tool_name":"Bash","tool_use_id":"toolu_01Gxj4wTfE8T1kBtCB5i65bd","tool_input":{"command":"cd cadence && .venv/bin/python _smoke_eval_ab.py","timeout":120000,"description":"Render the report table"}},{"tool_name":"Bash","tool_use_id":"toolu_01Wtzpzm8eSuKXdnUYDHD7Zf","tool_input":{"command":"cadence/.venv/bin/python cadence/_smoke_eval_ab.py","timeout":120000,"description":"Render the report table"}},{"tool_name":"Bash","tool_use_id":"toolu_01VVQLmb52ZvjGufRZNg2Lnb","tool_input":{"command":"rm cadence/_smoke_eval_ab.py","description":"Remove scratch smoke script"}},{"tool_name":"Bash","tool_use_id":"toolu_01Q2BdLd4Qp3Pm9ivpNSUtdq","tool_input":{"command":"rm -f /home/drspeedracer/Workspace/spotify-recsys-ecosystem-spot-4ec/cadence/_smoke_eval_ab.py","description":"Remove scratch smoke script"}},{"tool_name":"Bash","tool_use_id":"toolu_01L5aUWmGAf1ip