# The audit log and the review ledger are append-only JSONL: every line is one
# record carrying its own timestamp, and two branches that each appended are
# both telling the truth. Git's default merge treats that as a conflict, so
# every branch collided with every merge — three times in one afternoon, and
# each manual resolution was a chance to drop a record by picking a side.
#
# union keeps both sides' lines. It is the one case where "take everything" is
# not laziness but the correct semantics.
.flywheel/agent-log.jsonl merge=union
.flywheel/review.jsonl    merge=union
